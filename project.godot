; Engine configuration file.
; Plastic Platoon: Revenge 2026 - Godot 4.3+

config_version=5

[application]

config/name="Plastic Platoon: Revenge 2026"
config/description="Plastic soldiers. Modern warfare. A third-person toy-soldier shooter."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/game.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/handheld/orientation=4
window/stretch/mode.mobile="canvas_items"
window/stretch/aspect.mobile="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="pickups"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
